[
  {
    "type": "functionDef",
    "name": "ordenarBurbuja",
    "params": "",
    "children": [
      {
        "type": "obtenerLongitud",
        "listName": "miLista",
        "target": "tam"
      },
      {
        "type": "contar",
        "varName": "i",
        "from": "1",
        "to": "tam",
        "children": [
          {
            "type": "contar",
            "varName": "j",
            "from": "1",
            "to": "tam - 1",
            "children": [
              {
                "type": "if",
                "condition": "obtener(miLista, j) > obtener(miLista, j + 1)",
                "children": [
                  {
                    "type": "assign",
                    "varName": "temp",
                    "value": "obtener(miLista, j)"
                  },
                  {
                    "type": "modificarLista",
                    "listName": "miLista",
                    "pos": "j",
                    "value": "obtener(miLista, j + 1)"
                  },
                  {
                    "type": "modificarLista",
                    "listName": "miLista",
                    "pos": "j + 1",
                    "value": "temp"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
]