[
  {
    "type": "assign",
    "varName": "x",
    "value": "0"
  },
  {
    "type": "assign",
    "varName": "y",
    "value": "0"
  },
  {
    "type": "assign",
    "varName": "vivo",
    "value": "1"
  },
  {
    "type": "assign",
    "varName": "dir",
    "value": "1"
  },
  {
    "type": "forever",
    "children": [
      {
        "type": "keyCheck",
        "mode": "presionada",
        "key": "a",
        "target": "teclaPulsadaLeft"
      },
      {
        "type": "if",
        "condition": "teclaPulsadaLeft&&vivo==1",
        "children": [
          {
            "type": "assign",
            "varName": "x",
            "value": "x-0.1"
          },
          {
            "type": "assign",
            "varName": "dir",
            "value": "-1"
          }
        ]
      },
      {
        "type": "keyCheck",
        "mode": "presionada",
        "key": "d",
        "target": "teclaPulsadaRight"
      },
      {
        "type": "if",
        "condition": "teclaPulsadaRight&&vivo==1",
        "children": [
          {
            "type": "assign",
            "varName": "x",
            "value": "x+0.1"
          },
          {
            "type": "assign",
            "varName": "dir",
            "value": "1"
          }
        ]
      },
      {
        "type": "keyCheck",
        "mode": "presionada",
        "key": "w",
        "target": "wPush"
      },
      {
        "type": "if",
        "condition": "wPush&&vivo==1",
        "children": [
          {
            "type": "assign",
            "varName": "y",
            "value": "y+0.1"
          }
        ]
      },
      {
        "type": "keyCheck",
        "mode": "presionada",
        "key": "s",
        "target": "sPush"
      },
      {
        "type": "if",
        "condition": "sPush&&vivo==1",
        "children": [
          {
            "type": "assign",
            "varName": "y",
            "value": "y-0.1"
          }
        ]
      },
      {
        "type": "canvasClear"
      },
      {
        "type": "drawIMG",
        "src": "https://i.ibb.co/ycdX0kP3/manek-right-1-demo-3-2.png",
        "x": "x",
        "y": "y",
        "z": "0",
        "w": "4*dir",
        "h": "2"
      }
    ]
  }
]